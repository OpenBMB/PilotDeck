PILOTDECK_API_KEY=
PILOTDECK_MODEL=openai/gpt-4.1-mini
PILOTDECK_LIGHT_MODEL=openai/gpt-4.1-mini
PILOTDECK_API_URL=https://api.openai.com/v1
PILOTDECK_PORT=3001
PILOTDECK_NO_PROXY=api.openai.com,localhost,127.0.0.1

# The local default expects the portable runtime checkout beside PilotDeck.
# Point this at a released portable_sop checkout when exporting the product.
STAFFDECK_SOP_RUNTIME_CONTEXT=../../../StaffDeck-portable-sop
