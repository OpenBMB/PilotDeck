{
  "name": "funasr",
  "version": "0.2.0",
  "description": "Local audio transcription powered by the FunASR llama.cpp runtime",
  "mcpServers": {
    "funasr": {
      "command": "__PILOTDECK_NODE_EXECUTABLE__",
      "args": [
        "__PILOTDECK_FUNASR_MCP_ENTRYPOINT__",
        "--project-root",
        "__PILOTDECK_PROJECT_ROOT__",
        "--runtime-root",
        "__PILOTDECK_FUNASR_RUNTIME_ROOT__",
        "--install-command",
        "__PILOTDECK_FUNASR_INSTALL_COMMAND__"
      ],
      "perSession": true,
      "callTimeoutMs": 300000
    }
  }
}
